# Copy this file to ".env" and edit. NEVER commit the real .env file.

# development | production | testing
APP_ENV=development

# Required in production. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Optional extra secret for QR token hashing (defaults to SECRET_KEY).
QR_HASH_PEPPER=

# Database. Leave empty for SQLite (instance/smartconnect.db).
# PostgreSQL example:  postgresql://user:password@host:5432/smartconnect
DATABASE_URL=

# ---- Network ----
# LAN = running on a local computer, WAN = deployed on the internet (label only).
NETWORK_MODE=LAN
HOST=0.0.0.0
PORT=5000
# LAN_HTTPS=true serves HTTPS with a self-signed certificate (needed so phone
# cameras work over Wi-Fi). Create the certificate with: python scripts/make_cert.py
LAN_HTTPS=false
# Set both to true on Render / behind a reverse proxy.
BEHIND_PROXY=false
FORCE_HTTPS=false
# true when the site is served over HTTPS (LAN_HTTPS or production).
SESSION_COOKIE_SECURE=false

# ---- Behaviour ----
QR_TTL_MINUTES=1440
SYNC_MAX_AGE_HOURS=24
APP_TIMEZONE=Asia/Kolkata
SESSION_HOURS=8

# ---- First-time seeding (production only; demo mode uses documented local-testing passwords)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
